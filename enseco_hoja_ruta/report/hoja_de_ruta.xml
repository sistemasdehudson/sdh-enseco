<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- D2 · Acción del reporte, en el menú Imprimir del lote -->
    <record id="reparto_reporte_hoja_de_ruta" model="ir.actions.report">
        <field name="name">Hoja de ruta ENSECO</field>
        <field name="model">stock.picking.batch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">enseco_hoja_ruta.hoja_de_ruta_enseco</field>
        <field name="report_file">enseco_hoja_ruta.hoja_de_ruta_enseco</field>
        <field name="print_report_name">'Hoja de ruta - %s' % (object.name)</field>
        <field name="paperformat_id" ref="reparto_papel_a4_horizontal"/>
        <field name="binding_model_id" ref="stock_picking_batch.model_stock_picking_batch"/>
        <field name="binding_type">report</field>
    </record>

    <!-- D3 · Plantilla: una hoja A4 horizontal por lote -->
    <template id="hoja_de_ruta_enseco">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page" t-att-style="'page-break-after: always;' if not o_last else None">
                        <style>
                            .reparto-hr { font-family: Arial, Helvetica, sans-serif; color: #111827; font-size: 10px; }
                            .reparto-hr table { width: 100%; border-collapse: collapse; }
                            .reparto-hr td, .reparto-hr th { border: 1px solid #6b7280; padding: 4px 5px; vertical-align: top; }
                            .reparto-hr .reparto-encabezado td { vertical-align: middle; }
                            .reparto-hr .reparto-titulo { background-color: #FFD966; font-size: 13px; font-weight: bold; text-transform: uppercase; }
                            .reparto-hr .reparto-etiqueta { font-size: 10px; color: #4b5563; text-transform: uppercase; }
                            .reparto-hr .reparto-valor { font-size: 18px; font-weight: bold; text-transform: uppercase; line-height: 22px; }
                            .reparto-hr .reparto-filas { margin-top: 6px; }
                            .reparto-hr .reparto-filas th { font-weight: bold; text-align: center; vertical-align: middle; text-transform: uppercase; }
                            .reparto-hr .reparto-num { text-align: right; white-space: nowrap; }
                            .reparto-hr .reparto-total td { border-top: 2px solid #111827; font-weight: bold; vertical-align: middle; }
                            .reparto-hr .reparto-pie { margin-top: 10px; border-collapse: separate; border-spacing: 8px 0; }
                            .reparto-hr .reparto-pie td { height: 38px; width: 20%; font-size: 9px; text-transform: uppercase; }
                            .reparto-hr .reparto-pie .reparto-dato { font-size: 13px; font-weight: bold; text-transform: none; }
                        </style>
                        <div class="reparto-hr">
                            <!-- Encabezado: título con fecha, vehículo, vuelta y lote -->
                            <table class="reparto-encabezado">
                                <tr>
                                    <td class="reparto-titulo" style="width: 36%;">
                                        HOJA DE RUTA · <t t-out="o._reparto_titulo_fecha()"/>
                                    </td>
                                    <td style="width: 34%;">
                                        <div class="reparto-etiqueta">Vehículo</div>
                                        <div class="reparto-valor" t-out="o.vehicle_id.display_name"/>
                                    </td>
                                    <td style="width: 16%;">
                                        <div class="reparto-etiqueta">Vuelta</div>
                                        <div class="reparto-valor" t-out="o._reparto_vuelta_texto()"/>
                                    </td>
                                    <td style="width: 14%; text-align: right;">
                                        <strong>Lote:</strong>
                                        <div t-out="o.name"/>
                                    </td>
                                </tr>
                            </table>

                            <!-- Remitos ordenados por orden de entrega -->
                            <table class="reparto-filas">
                                <thead>
                                    <tr>
                                        <th style="width: 6%;">Nº presup.</th>
                                        <th style="width: 8%;">Remito</th>
                                        <th style="width: 10%;">Cliente</th>
                                        <th style="width: 8%;">Teléfono de contacto</th>
                                        <th style="width: 12%;">Dirección</th>
                                        <th style="width: 6%;">Zona</th>
                                        <th style="width: 6%;">Peso (kg)</th>
                                        <th style="width: 8%;">Orden de entrega</th>
                                        <th style="width: 7%;">Lado de descarga</th>
                                        <th style="width: 15%;">Observaciones</th>
                                        <th style="width: 6%;">¿Recibe con lluvia?</th>
                                        <th style="width: 8%;">Confirmación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.picking_ids.sorted(key=lambda p: (p.reparto_orden_parada or '99', p.batch_sequence, p.id))" t-as="p">
                                        <tr>
                                            <td t-out="p.origin"/>
                                            <td t-out="p.name"/>
                                            <td t-out="p.partner_id.display_name"/>
                                            <td t-field="p.reparto_telefono_obra"/>
                                            <td t-field="p.reparto_direccion_entrega"/>
                                            <td t-field="p.reparto_zona"/>
                                            <td class="reparto-num">
                                                <span t-out="p.shipping_weight" t-options="{'widget': 'float', 'precision': 2}"/>
                                            </td>
                                            <td><strong t-out="p._reparto_orden_entrega_texto()"/></td>
                                            <td t-field="p.reparto_lado_descarga"/>
                                            <td t-field="p.reparto_obs_logistica"/>
                                            <td t-field="p.reparto_recibe_lluvia"/>
                                            <td t-field="p.reparto_confirmacion"/>
                                        </tr>
                                    </t>
                                    <tr class="reparto-total">
                                        <td colspan="6" style="text-align: right;">TOTAL DE LA VUELTA</td>
                                        <td class="reparto-num">
                                            <span t-out="o.estimated_shipping_weight" t-options="{'widget': 'float', 'precision': 2}"/>
                                        </td>
                                        <td colspan="5">
                                            <t t-if="o.vehicle_weight_capacity">
                                                de <span t-out="o.vehicle_weight_capacity" t-options="{'widget': 'float', 'precision': 0}"/> kg de capacidad ·
                                                <span t-out="o.used_weight_percentage" t-options="{'widget': 'float', 'precision': 0}"/> %
                                                <t t-if="o.used_weight_percentage &gt; 100"> · EXCEDE LA CAPACIDAD</t>
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- Pie: lo anota el chofer o sale impreso si Almacenes ya lo cargó -->
                            <table class="reparto-pie">
                                <tr>
                                    <td>
                                        KM salida
                                        <div t-if="o.reparto_km_salida" class="reparto-dato" t-field="o.reparto_km_salida"/>
                                    </td>
                                    <td>
                                        Hora salida
                                        <div t-if="o.reparto_hora_salida" class="reparto-dato" t-out="o._reparto_hora('reparto_hora_salida')"/>
                                    </td>
                                    <td>
                                        KM regreso
                                        <div t-if="o.reparto_km_regreso" class="reparto-dato" t-field="o.reparto_km_regreso"/>
                                    </td>
                                    <td>
                                        Hora regreso
                                        <div t-if="o.reparto_hora_regreso" class="reparto-dato" t-out="o._reparto_hora('reparto_hora_regreso')"/>
                                    </td>
                                    <td>Firma del chofer</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
