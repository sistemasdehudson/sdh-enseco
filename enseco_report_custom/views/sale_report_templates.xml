<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit and modify the sale order document template -->
    <template id="report_saleorder_document_enseco" inherit_id="l10n_ar_sale.report_saleorder_document">
        <!-- Hide tax column header when without_tax or without_prices is True -->
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-att-style">'display: none;' if (without_prices or without_prices_tax) else ''</attribute>
            <attribute name="t-att-class">' ' if (without_tax or without_prices or without_prices_tax) else 'class="text-end d-md-table-cell"'</attribute>
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="t-att-style">'display: none;' if (without_prices or without_prices_tax) else ''</attribute>
            <attribute name="t-att-class">' ' if (without_tax or without_prices or without_prices_tax) else 'class="text-end d-md-table-cell"'</attribute>
        </xpath>
        <!-- Hide price unit column header when without_prices is True -->
        <xpath expr="//th[@name='th_priceunit']" position="attributes">
            <attribute name="t-att-style">'display: none;padding: 0px 2px; ' if without_prices or without_prices_tax else 'padding: 0px 2px;'</attribute>
        </xpath>
        <!-- Hide price unit column data when without_prices is True -->
        <xpath expr="//td[@name='td_product_priceunit']" position="attributes">
            <attribute name="t-att-style">'display: none;padding: 0px 2px;' if without_prices or without_prices_tax else 'padding: 0px 2px;'</attribute>
        </xpath>
        <!-- Hide subtotal column header when without_prices is True -->
        <!--
        <xpath expr="//th[@name='th_subtotal']" position="attributes">
            <attribute name="t-att-style">'display: none;' if without_prices or without_prices_tax else ''</attribute>
        </xpath>
        -->
        <xpath expr="//th[span[text()='SubTotal']]"  position="attributes">
            <attribute name="t-att-style">'display: none;' if without_prices or without_prices_tax else ''</attribute>
            <attribute name="t-att-class">' ' if (without_tax or without_prices or without_prices_tax) else 'class="text-end d-md-table-cell"'</attribute>
        </xpath>
        <xpath expr="//th[span[text()='Total']]"  position="attributes">
            <attribute name="t-att-style">'display: none;' if without_prices or without_prices_tax else ''</attribute>
            <attribute name="t-att-class">' ' if (without_tax or without_prices or without_prices_tax) else 'class="text-end d-md-table-cell"'</attribute>
        </xpath>
        <!-- Hide subtotal column data when without_prices is True -->
        <xpath expr="//table[hasclass('o_main_table')]" position="attributes">
            <attribute name="style" add="font-size: 10px;" separator=" " />
        </xpath>
        <xpath expr="//td[@name='td_product_taxes']" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" " />
        </xpath>
        <!-- Hide tax column data when without_tax or without_prices is True -->
        <xpath expr="//td[@name='td_product_taxes']" position="attributes">
            <attribute name="t-att-style">'display: none;padding: 0px 2px;' if (without_prices or without_prices_tax) else 'padding: 0px 2px;'</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_subtotal']" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" " />
        </xpath>
        <xpath expr="//td[@name='td_product_discount']" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" " />
        </xpath>
        <xpath expr="//td[@name='td_product_discount']" position="attributes">
            <attribute name="t-att-style">'display: none;padding: 0px 2px;' if without_prices or without_prices_tax else 'padding: 0px 2px;'</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_subtotal']" position="attributes">
            <attribute name="t-att-style">'display: none;' if without_prices or without_prices_tax else 'padding: 0px 2px;'</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_name']" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" " />
        </xpath>
        <xpath expr="//td[@name='td_product_priceunit']" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" " />
        </xpath>
        <xpath expr="//td[@name='td_product_quantity']" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" " />
        </xpath>
        <t t-call="l10n_ar_sale.document_tax_totals" position="attributes">
            <attribute name="t-call">{{'l10n_ar_sale.document_tax_totals' if without_prices_tax or (not without_tax and not without_prices_tax and not without_prices) else 'enseco_report_custom.report_totals_without_prices'}}</attribute>
        </t>
    </template>
    <template id="report_totals_without_prices">
                <tr class="o_total">
                    <td>
                        <strong>Total</strong>
                    </td>
                    <td class="text-end">
                        <strong t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </td>
                </tr>
    </template>
    <!-- Report template for sale order without taxes -->
    <template id="report_saleorder_without_tax">
        <t t-call="web.html_container">
            <t t-set="without_tax" t-value="True" />
            <t t-foreach="docs" t-as="doc">
                <t t-call="enseco_report_custom.report_saleorder_document_enseco" t-lang="doc.partner_id.lang" />
            </t>
        </t>
    </template>
    <!-- Report template for sale order without prices and taxes -->
    <template id="report_saleorder_without_prices">
        <t t-call="web.html_container">
            <t t-set="without_prices" t-value="True" />
            <t t-foreach="docs" t-as="doc">
                <t t-call="enseco_report_custom.report_saleorder_document_enseco" t-lang="doc.partner_id.lang" />
            </t>
        </t>
    </template>
    <!-- Report template for sale order without prices with taxes -->
    <template id="report_saleorder_without_prices_tax">
        <t t-call="web.html_container">
            <t t-set="without_prices_tax" t-value="True" />
            <t t-foreach="docs" t-as="doc">
                <t t-call="enseco_report_custom.report_saleorder_document_enseco" t-lang="doc.partner_id.lang" />
            </t>
        </t>
    </template>
</odoo>