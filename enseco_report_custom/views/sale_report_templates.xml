<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document" inherit_id="l10n_ar_sale.report_saleorder_document">
        <xpath expr="//td//span[contains(text(), 'SubTotal')]/.." position="replace">
            <th name="th_subtotal" t-if="doc.vat_discriminated" class="text-end">
                <span>SubTotal</span>
            </th>
        </xpath>
        <xpath expr="//td//span[contains(text(), 'Total')]/.." position="replace">
            <th name="th_subtotal" t-else="" class="text-end">
                <span>Total</span>
            </th>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="replace">
            <th name="th_taxes" t-att-style="'display: none;' if without_tax else ''" t-attf-class="text-left {{ 'd-md-table-cell' if report_type == 'html' else '' }}"><span>IVA</span></th>
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="replace">
            <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_id])"/>
            <td name="td_taxes" t-att-style="'display: none;' if without_tax else ''" >
                <span t-out="taxes">Tax 15%</span>
            </td>
        </xpath>
        <t t-call="l10n_ar_sale.document_tax_totals" position="attributes">
            <attribute name="t-call">enseco_report_custom.document_tax_totals</attribute>
        </t>
    </template>

    <template id="document_tax_totals" inherit_id="account.document_tax_totals">
        <t t-call="account.tax_groups_totals" position="replace">
            <t t-if="not without_tax">
                <t t-call="account.tax_groups_totals"/>
            </t>
        </t>
        <xpath expr="//t//tr[contains(@class, 'o_subtotal')]" position="attributes">
            <attribute name="t-att-style" value="'display: none;' if without_tax else ''">'display: none;' if without_tax else ''</attribute>
        </xpath>
    </template>

    <template id="report_saleorder_without_tax">
        <t t-call="web.html_container">
            <t t-set="without_tax" t-value="True"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="enseco_report_custom.report_saleorder_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>