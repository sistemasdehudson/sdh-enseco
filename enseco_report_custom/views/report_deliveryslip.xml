<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <template id="report_delivery_document" priority="21" inherit_id="l10n_ar_stock_ux.report_delivery_document">
        <xpath expr="//t[@t-if='o.declared_value']" position="after">
            <t t-if="o.weight and custom">
                <br/>
                <strong>PESO TOTAL:</strong>
                <span t-field="o.weight"/>
                <span t-field="o.weight_uom_name"/>
            </t>  
        </xpath>
    <!-- FORMATO DE TABLA DE PRODUCTOS -->
	   <xpath expr="//table[@name='stock_move_table']" position="attributes">
            <attribute name="style" add="font-size: 10px;" separator=" " />
        </xpath>
	   <xpath expr="//table[@name='stock_move_line_table']" position="attributes">
            <attribute name="style" add="font-size: 10px;" separator=" " />
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']//thead//tr" position="inside">
            <th name="th_sml_quantity_det" class="text-center" t-if="custom"><strong>DETALLE DE CANTIDAD</strong></th>
        </xpath>
    </template>
    <template id="stock_report_delivery_aggregated_move_lines" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[1]" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" "/>
        </xpath>
        <xpath expr="//td[2]" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" "/>
        </xpath>
        <xpath expr="//td[3]" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" "/>
        </xpath>
        <xpath expr="//td[4]" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" "/>
        </xpath>
    </template>
    <template id="report_delivery_document_stock" inherit_id="stock.report_delivery_document">
        <!-- Solo en el Recibo ENSECO: cantidades con el formato del idioma (54 · 36,04 · 10.000) -->
        <xpath expr="//t[@t-set='format_number']" position="after">
            <t t-if="custom">
                <t t-set="lang_enseco" t-value="o.env['res.lang']._lang_get(o.env.lang or 'es_AR')"/>
                <t t-set="format_number" t-value="lambda x: lang_enseco.format('%.4f', x, grouping=True).rstrip('0').rstrip(lang_enseco.decimal_point)"/>
            </t>
        </xpath>

        <xpath expr="//td//span[@t-field='move.product_uom']" position="replace">
            <span t-field="move.product_uom">units</span>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//thead//tr" position="inside">
            <th name="th_sm_quantity_det" class="text-end" t-if="custom"><strong>DETALLE DE CANTIDAD</strong></th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//tbody//tr" position="inside">
            <td class="text-end" name="move_line_aggregated_quantity_detail" style="padding: 0px 2px;" t-if="custom">
                <t t-call="enseco_report_custom.quantity_detail_enseco"/>
            </td>
        </xpath>
        <!-- Remitos sin validar: cantidad del empaquetado (línea gris) con el mismo formato en Ordenado y Entregado -->
        <xpath expr="//table[@name='stock_move_table']//span[@t-field='move.packaging_uom_qty']" position="attributes">
            <attribute name="t-if">not custom</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//span[@t-field='move.packaging_uom_qty']" position="after">
            <span class="text-muted" t-if="custom" t-out="format_number(move.packaging_uom_qty)"/>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//span[@t-esc='move.product_uom._compute_quantity(move.quantity, move.packaging_uom_id)']" position="attributes">
            <attribute name="t-esc">format_number(move.product_uom._compute_quantity(move.quantity, move.packaging_uom_id)) if custom else move.product_uom._compute_quantity(move.quantity, move.packaging_uom_id)</attribute>
        </xpath>
    </template>
    <template id="stock_report_delivery_aggregated_move_lines" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//tr" position="inside">
            <td class="text-center" name="move_line_aggregated_quantity_detail" style="padding: 0px 2px;" t-if="custom">
                <t t-call="enseco_report_custom.quantity_detail_enseco">
                    <t t-set="move" t-value="aggregated_lines[line]['move']"/>
                </t>
            </td>
        </xpath>
        <!-- Cantidad del empaquetado (línea gris) con el mismo formato que la cantidad principal -->
        <xpath expr="//span[@t-out=&quot;aggregated_lines[line]['packaging_qty_ordered']&quot;]" position="attributes">
            <attribute name="t-out">format_number(aggregated_lines[line]['packaging_qty_ordered']) if custom else aggregated_lines[line]['packaging_qty_ordered']</attribute>
        </xpath>
        <xpath expr="//span[@t-out=&quot;aggregated_lines[line]['packaging_quantity']&quot;]" position="attributes">
            <attribute name="t-out">format_number(aggregated_lines[line]['packaging_quantity']) if custom else aggregated_lines[line]['packaging_quantity']</attribute>
        </xpath>
    </template>

    <template id="quantity_detail_enseco">
        <t t-set="sale_uom" t-value="move.sale_line_id.product_uom_id"/>
        <t t-if="sale_uom and sale_uom != move.product_uom" t-out="'%s U. de %s' % (format_number(move.quantity / (sale_uom.factor or 1)), sale_uom.name)"/>
    </template>

    <template id="report_deliveryslip_enseco">
        <t t-call="web.html_container">
            <t t-set="custom" t-value="True"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="enseco_report_custom.report_delivery_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
