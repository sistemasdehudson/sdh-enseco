<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document" inherit_id="l10n_ar_stock.report_delivery_document">
        <xpath expr="//t[@t-if='o.declared_value']" position="replace">
            <t t-if="o.weight">
                <br/>
                <strong>PESO TOTAL:</strong>
                <span t-field="o.weight"/>
                <span t-field="o.weight_uom_name"/>
            </t>  
        </xpath>
        <xpath expr="//p[@name='comment']" position="before">
            <t t-if="o.declared_value">
                <br/>
                <strong>Valor declarado:</strong>
                <span t-field="o.declared_value"/>
            </t>            
        </xpath>
        <xpath expr="//th[@name='th_sm_ordered']" position="replace"/>
        <xpath expr="//td//span[@t-field='move.product_uom_qty']/.." position="replace"/>
        <xpath expr="//td//span[@t-field='move.product_uom']" position="replace">
            <span t-field="move.product_id.dimensional_uom_id">units</span>
        </xpath>
        <xpath expr="//table[@name='stock_backorder_table']/.." position="replace"/>
        <xpath expr="//table[@name='stock_move_table']//thead//tr" position="inside">
            <th name="th_sm_quantity_detail"><strong>DETALLE x UNIDAD</strong></th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//tbody//tr" position="inside">
            <td name="td_sm_quantity_detail">
                <div t-if="move.product_id.product_length > 0">
                    <t t-out="'Largo:'"/>
                    <span t-field="move.product_id.product_length">1,00</span>
                    <span t-field="move.product_id.dimensional_uom_id">units</span>
                </div>
                <div t-if="move.product_id.product_height > 0">
                    <t t-out="'Alto:'"/>
                    <span t-field="move.product_id.product_height">1,00</span>
                    <span t-field="move.product_id.dimensional_uom_id">units</span>
                </div>
                <div t-if="move.product_id.product_width > 0">
                    <t t-out="'Ancho:'"/>
                    <span t-field="move.product_id.product_width">1,00</span>
                    <span t-field="move.product_id.dimensional_uom_id">units</span>
                </div>
            </td>
        </xpath>
    </template>
</odoo>