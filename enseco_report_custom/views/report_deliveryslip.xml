<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <template id="report_delivery_document" priority="21" inherit_id="l10n_ar_stock_ux.report_delivery_document">
        <xpath expr="//t[@t-if='o.declared_value']" position="after">
            <t t-if="o.weight and custom">
                <br/>
                <strong>PESO TOTAL:</strong>
                <span t-field="o.weight"/>
                <span t-field="o.weight_uom_name"/>
            </t>  
        </xpath>
    <!-- FORMATO DE TABLA DE PRODUCTOS -->
	   <xpath expr="//table[@name='stock_move_table']" position="attributes">
            <attribute name="style" add="font-size: 10px;" separator=" " />
        </xpath>
	   <xpath expr="//table[@name='stock_move_line_table']" position="attributes">
            <attribute name="style" add="font-size: 10px;" separator=" " />
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']//thead//tr" position="inside">
            <th name="th_sml_quantity_det" class="text-center" t-if="custom"><strong>DETALLE DE CANTIDAD</strong></th>
        </xpath>
    </template>
    <template id="stock_report_delivery_aggregated_move_lines" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[1]" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" "/>
        </xpath>
        <xpath expr="//td[2]" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" "/>
        </xpath>
        <xpath expr="//td[3]" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" "/>
        </xpath>
        <xpath expr="//td[4]" position="attributes">
            <attribute name="style" add="padding: 0px 2px;" separator=" "/>
        </xpath>
    </template>
    <template id="report_delivery_document_stock" inherit_id="stock.report_delivery_document">

        <xpath expr="//td//span[@t-field='move.product_uom']" position="replace">
            <span t-field="move.product_id.dimensional_uom_id" t-if="custom">units</span>
            <span t-field="move.product_uom" t-else="">units</span>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//thead//tr" position="inside">
            <th name="th_sm_quantity_det" class="text-end" t-if="custom"><strong>DETALLE DE CANTIDAD</strong></th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']//tbody//tr" position="inside">
            <td class="text-end" name="move_line_aggregated_quantity_detail" style="padding: 0px 2px;">
                <span t-field="move.quantity_detail" t-if="custom"/>
            </td>
        </xpath>
    </template>
    <template id="stock_report_delivery_aggregated_move_lines" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//tr" position="inside">
            <td class="text-center" name="move_line_aggregated_quantity_detail" style="padding: 0px 2px;">
                <span t-esc="aggregated_lines[line]['move'].quantity_detail"/>
            </td>
        </xpath>
    </template>

    <template id="report_deliveryslip_enseco">
        <t t-call="web.html_container">
            <t t-set="custom" t-value="True"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="enseco_report_custom.report_delivery_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
